# Dependencies
node_modules

# Build output
dist
release
verify
icon-temp.html
*.tsbuildinfo

# Android build staging (regenerated by android/build-apk.ps1 from dist/)
android/assets

# Signing keys — NEVER COMMIT THESE.
# The keystore is the APK signing identity: whoever holds it can sign an update
# that Android will happily install over this app. Keep a private backup.
*.keystore
*.jks
*.p12
*.pem
*.key

# Packaged binaries
*.apk
*.aab
*.exe

# Environment & secrets
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*

# OS / editor cruft
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea
*.iml