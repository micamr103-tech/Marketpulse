# Normalise line endings in the repo; check out per-platform.
* text=auto

*.ts   text eol=lf
*.tsx  text eol=lf
*.mjs  text eol=lf
*.cjs  text eol=lf
*.js   text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.json text eol=lf
*.java text eol=lf
*.xml  text eol=lf
*.md   text eol=lf

# PowerShell must stay CRLF-with-BOM-free-friendly on disk for PS 5.1.
*.ps1  text eol=crlf

# Never mangle binaries.
*.png  binary
*.jpg  binary
*.jpeg binary
*.ico  binary
*.webmanifest text eol=lf